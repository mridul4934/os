+	pr_info("fork_guard: ready (threshold=%u per %ums, throttle=%ums, cooldown=%us)\n",
+		fg_threshold, fg_window_ms, fg_throttle_ms, fg_cooldown_s);
+	return 0;
+}
+late_initcall(fork_guard_init);
